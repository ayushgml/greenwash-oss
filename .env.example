# GitHub App settings (from https://github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=greenwash
GITHUB_WEBHOOK_SECRET=
# PEM private key; literal \n sequences are converted to newlines
GITHUB_PRIVATE_KEY=

# TypeSafe (from https://console.typesafe.ai/settings/keys)
TYPESAFE_API_KEY=
# Optional model override, e.g. jev-preview (default: jev-latest)
TYPESAFE_MODEL=
